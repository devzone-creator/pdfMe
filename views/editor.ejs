<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>PDFMe — Editor</title>
  <link rel="stylesheet" href="/css/editor.css">
</head>
<body>
  <header class="topbar">
    <h1>PDFMe Editor</h1>
    <div class="controls">
      <button id="addText">Add Text</button>
      <label class="file-btn">Import DOCX<input id="docxInput" type="file" accept=".docx" style="display:none"></label>
      <label class="file-btn">Upload Image<input id="imageInput" type="file" accept="image/*" style="display:none"></label>
      <button id="exportPDF">Export PDF</button>
      <a href="/" class="back">Back</a>
    </div>
  </header>

  <main>
    <div id="canvasContainer" class="canvas-container">
      <canvas id="canvas" width="595" height="842"></canvas>
    </div>
    <div id="status" class="status"></div>
  </main>

  <!-- Libraries from CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/4.6.0/fabric.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="/js/editor.js"></script>
</body>
</html>
